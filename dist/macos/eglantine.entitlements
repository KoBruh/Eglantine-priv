<!-- The entitlements eglantine and eden-cli are signed with: by the build (src/yuzu and src/yuzu_cmd
     CMakeLists.txt) and by tools/macos/package.sh. Hypervisor.framework runs native execution, the
     default CPU backend; allow-jit lets the dynarmic JIT backend map executable memory. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.hypervisor</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
